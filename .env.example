# ---- Frontend (set in Netlify > Site configuration > Environment variables) ----
VITE_API_BASE_URL=http://localhost:8000/api

# ---- Backend (set in Render > Environment) ----
ALLOWED_ORIGINS=http://localhost:8080,https://your-site.netlify.app
# ALLOWED_ORIGIN_REGEX=https://.*--your-site\.netlify\.app   # optional: Netlify deploy previews
DB_PATH=/data/resqroute.db
LOG_LEVEL=INFO
